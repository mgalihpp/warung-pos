// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Better Auth Models
// ============================================================================

model User {
  id            String    @id @db.VarChar(32)
  name          String     @db.VarChar(100)
  email         String     @unique @db.VarChar(255)
  emailVerified Boolean
  image         String?    @db.VarChar(500)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @db.Timestamptz(6)
  role          String?    @db.VarChar(20)
  banned        Boolean?
  banReason     String?    @db.VarChar(255)
  banExpires    DateTime? @db.Timestamptz(6)
  accounts      Account[]
  sessions      Session[]

  // Business relations
  transactions     Transaction[]
  stockAdjustments StockAdjustment[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime @db.Timestamptz(6)
  token          String   @unique @db.VarChar(512)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @db.Timestamptz(6)
  ipAddress      String?  @db.VarChar(45)
  userAgent      String?  @db.VarChar(512)
  userId         String   @db.VarChar(128)
  impersonatedBy String?  @db.VarChar(128)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.VarChar(128)
  providerId            String    @db.VarChar(50)
  userId                String    @db.VarChar(128)
  accessToken           String?   @db.VarChar(512)
  refreshToken          String?   @db.VarChar(512)
  idToken               String?   @db.VarChar(2048)
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?   @db.VarChar(255)
  password              String?   @db.VarChar(255)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String @db.VarChar(255)
  value      String @db.VarChar(255)
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @db.Timestamptz(6)

  @@index([identifier])
  @@map("verification")
}

// ============================================================================
// Business Models — Inventori & Transaksi
// ============================================================================

/// Metode pembayaran dicatat manual, tanpa integrasi payment gateway pihak ketiga.
enum PaymentMethod {
  CASH
  QRIS_MANUAL
  MANUAL_TRANSFER
}

enum TransactionStatus {
  COMPLETED
  PENDING
  CANCELLED
}

/// Kategori barang (Sembako, Rokok, Minuman, Snack, dll)
model Category {
  id          String   @id @default(cuid()) @db.VarChar(30)
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  products Product[]

  @@map("category")
}

/// Data barang lengkap dengan harga beli, harga jual, stok, dan satuan.
/// Margin keuntungan dihitung di aplikasi: margin = sellPrice - buyPrice
model Product {
  id          String   @id @default(cuid()) @db.VarChar(30)
  name        String   @db.VarChar(200)
  categoryId  String   @db.VarChar(30)
  image       String?  @db.VarChar(500) // URL gambar dari UploadThing
  unit        String   @db.VarChar(50) // pcs, bungkus, botol, sachet, dus
  stock       Int      @default(0)
  minStock    Int      @default(5)
  buyPrice    Float // Harga beli (modal)
  sellPrice   Float // Harga jual
  description String?  @db.VarChar(1000)
  isActive    Boolean  @default(true) // Soft-delete flag
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactionItems TransactionItem[]
  stockAdjustments StockAdjustment[]

  @@index([categoryId])
  @@index([name])
  @@index([isActive])
  @@map("product")
}

/// Transaksi penjualan. cashierName di-denormalize agar laporan tetap
/// akurat meskipun data user berubah di masa depan.
model Transaction {
  id            String            @id @default(cuid()) @db.VarChar(30)
  transactionNumber String        @unique @db.VarChar(30)
  cashierId     String            @db.VarChar(32)
  cashierName   String            @db.VarChar(100) // Denormalized
  paymentMethod PaymentMethod     @default(CASH)
  status        TransactionStatus @default(COMPLETED)
  subtotal      Float
  total         Float
  amountPaid    Float
  change        Float // amountPaid - total
  notes         String?  @db.VarChar(500)
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  cashier User              @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  items   TransactionItem[]

  @@index([cashierId])
  @@index([createdAt])
  @@index([transactionNumber])
  @@map("transaction")
}

/// Detail item per transaksi. productName dan unitPrice di-denormalize
/// karena harga barang bisa berubah seiring waktu.
model TransactionItem {
  id            String   @id @default(cuid()) @db.VarChar(30)
  transactionId String   @db.VarChar(30)
  productId     String   @db.VarChar(30)
  productName   String   @db.VarChar(200) // Denormalized — nama produk saat transaksi
  unitPrice     Float // Denormalized — harga jual saat transaksi
  costPrice     Float // Denormalized — harga modal saat transaksi
  quantity      Int
  subtotal      Float // unitPrice × quantity
  grossProfit   Float // (unitPrice - costPrice) × quantity
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([productId])
  @@map("transaction_item")
}

/// Audit trail perubahan stok.
/// Type: IN (restok), OUT (penjualan), CORRECTION (koreksi manual)
model StockAdjustment {
  id          String   @id @default(cuid()) @db.VarChar(30)
  productId   String   @db.VarChar(30)
  userId      String   @db.VarChar(32)
  type        String   @db.VarChar(20) // IN | OUT | CORRECTION
  quantity    Int // Jumlah perubahan (positif)
  stockBefore Int
  stockAfter  Int
  reason      String?  @db.VarChar(500)
  referenceId String?  @db.VarChar(30) // ID referensi (misal: Transaction ID)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
  @@map("stock_adjustment")
}
